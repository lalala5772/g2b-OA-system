# cp .env.example .env — never commit .env
AI_ENGINE_API_KEY=replace-with-a-random-shared-secret

# Claude (Anthropic) — used by bids/documents/ideas/evidence for judgment & extraction
CLAUDE_API_KEY=replace-with-your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-5

# 나라장터 Open API (BidPublicInfoService) — use the DECODING key, not the encoding key.
# requests.get(params=...) URL-encodes it for you; pasting the already-encoded key double-encodes it.
NARAJANGTEO_SERVICE_KEY=replace-with-your-decoding-service-key
NARAJANGTEO_BASE_URL=https://apis.data.go.kr/1230000/ad/BidPublicInfoService

# Slack Incoming Webhook — leave unset to skip notifications (logged as SKIPPED, no crash)
SLACK_WEBHOOK_URL=

# Local embedding model for evidence-file matching (Phase 5) — no API key needed
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
